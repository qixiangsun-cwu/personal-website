ZHIPU_API_KEY=请填入你的ZHIPU_API_KEY
# LLM提速：换更快的GLM模型（11/14），回退就删掉这行
ZHIPU_MODEL=glm-4-flashx
TTS_VOICE=tongtong
# 火山引擎流式ASR（你去开通后填这里）：
VOLCANO_APP_KEY=请填入你的VOLCANO_APP_KEY
VOLCANO_ACCESS_KEY=
VOLCANO_APP_ID=
VOLCANO_RESOURCE_ID=volc.seedasr.sauc.duration

# 工程师Agent（阿里云百炼 Qwen，OpenAI兼容；专属业务空间端点）
ENGINEER_API_KEY=请填入你的ENGINEER_API_KEY
ENGINEER_BASE_URL=https://ws-qssy961mb1xnbaip.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ENGINEER_MODEL=qwen3.7-plus

# 实时工具调用（Function Calling，江 11/12）：off = 一键退回纯状态机
TOOL_CALL=on
TOOL_TIMEOUT_MS=1600

# 【火山云TTS·冉 11/13】按 TTS_BACKEND 选厂商（volcano/zhipu），改 zhipu 一键回智谱
TTS_BACKEND=volcano
